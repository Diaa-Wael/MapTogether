{
  "name": "maptogether",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@maptogether/web",
    "dev:server": "npm run dev --workspace=@maptogether/sync-server",
    "build": "npm run build --workspace=@maptogether/web",
    "start": "npm run start --workspace=@maptogether/sync-server"
  }
}